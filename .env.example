# 仅启用一个来源时，SOURCES 填 nodeseek 或 sb。停用来源的配置不校验。
SOURCES=nodeseek,sb

# NodeSeek 独立配置；可以与另一站填写同一个 MeoW 昵称。
NODESEEK_MEOW_NICKNAME=你的MeoW昵称
NODESEEK_CHECK_INTERVAL_SECONDS=5
NODESEEK_CATEGORIES=all
NODESEEK_MATCH_SCOPE=all
NODESEEK_KEYWORDS=VPS,优惠,补货
NODESEEK_KEYWORD_GROUPS=[]
NODESEEK_REGEX_PATTERNS=[]
NODESEEK_PUSH_CATEGORY=
NODESEEK_BLOCK_KEYWORDS=求购,已收
NODESEEK_PUSH_EXISTING=false
NODESEEK_SHOW_LINK_URL=false
NODESEEK_HEALTH_CHECK_MINUTES=1440

# 烧饼论坛 独立配置；可以与另一站填写同一个 MeoW 昵称。
SB_MEOW_NICKNAME=你的MeoW昵称
SB_CHECK_INTERVAL_SECONDS=60
SB_CATEGORIES=all
SB_MATCH_SCOPE=all
SB_KEYWORDS=VPS,优惠,补货
SB_KEYWORD_GROUPS=[]
SB_REGEX_PATTERNS=[]
SB_PUSH_CATEGORY=
SB_BLOCK_KEYWORDS=求购,已收
SB_PUSH_EXISTING=false
SB_SHOW_LINK_URL=false
SB_HEALTH_CHECK_MINUTES=1440
